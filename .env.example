# ------------------------------------------------------------------
# Configuration du frontend SmartCampus AI
# Copier ce fichier en .env.local puis adapter les valeurs.
# ------------------------------------------------------------------

# URL de base du backend (FastAPI).
# Laisser vide pour utiliser les données mockées locales (aucun backend requis).
# Exemple : NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# Forcer le mode mock même si une URL est configurée ("true" / "false").
# Si laissé vide : le mode mock est actif uniquement quand l'URL est vide.
NEXT_PUBLIC_USE_MOCK_API=

# URL du formulaire de préinscription de la faculté (lien externe).
# Remplacer par l'URL réelle du formulaire, ex. https://nau.tn/
# Laisser vide pour masquer les boutons « Se préinscrire ».
NEXT_PUBLIC_PREINSCRIPTION_URL=https://nau.tn/
