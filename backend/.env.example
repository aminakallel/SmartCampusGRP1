# Set from a secret manager. Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=smartcampus-api
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Required for authentication in production. Never enable in a deployed environment.
AUTH_USE_IN_MEMORY=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# SA-25 guest-session lifetime (default: 24 hours).
GUEST_SESSION_TTL_SECONDS=86400
