# Copy this file to .env for local use. Replace local-only credentials as needed.
APP_NAME=SmartCampus AI API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
LLM_TIMEOUT_SECONDS=30
# Comma-separated explicit origins; wildcard origins are rejected.
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://smartcampus:change-me-local@127.0.0.1:55432/smartcampus
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=change-me-local
